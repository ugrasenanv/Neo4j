# Neo4j Database Configuration
# Get these from your Neo4j AuraDB instance dashboard
NEO4J_URI=neo4j+s://abc123.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# OpenAI API Configuration
# Required for LLM features (neo4j_qa and vector_search modules)
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: LangChain Configuration
# Uncomment to enable verbose logging for debugging
# LANGCHAIN_DEBUG=true
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your-api-key
